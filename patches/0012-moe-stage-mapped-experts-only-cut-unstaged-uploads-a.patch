diff --git a/src/llama-host-stager.h b/src/llama-host-stager.h
index 7f5b807dd..d8e4a1bba 100644
--- a/src/llama-host-stager.h
+++ b/src/llama-host-stager.h
@@ -10,12 +10,15 @@
 
 struct llama_model;
 
-// Uploads bytes of host weights to a device through pinned staging buffers.
+// Uploads bytes of memory-mapped host weights to a device through pinned staging buffers.
 //
-// The experts kept in host memory are memory-mapped and pageable, so a plain upload is a synchronous copy by the
-// driver that soft-faults the mapping one page at a time on one thread (2 to 3 GB/s, less when the pages come from
-// the disk). Here several threads copy the source into a pinned buffer, the faults scale with the threads, and the
-// device reads the pinned buffer asynchronously while the threads fill the other buffer.
+// Experts kept in a mapping are pageable, so a plain upload is a synchronous copy by the driver that soft-faults the
+// mapping one page at a time on one thread (2 to 3 GB/s, less when the pages come from the disk). Here several
+// threads copy the source into a pinned buffer, the faults scale with the threads, and the device reads the pinned
+// buffer asynchronously while the threads fill the other buffer.
+//
+// Experts read into an allocated buffer (no mmap) are not staged: nothing faults there, the buffer is pinned when the
+// backend offers pinned host memory, and the extra copy halved generation on a 97 GiB pool (36 against 63 tok/s).
 //
 // The pages touched for a large batch are marked as the first to evict: a prompt reads every expert of a layer, and
 // without that mark the scan pushes the experts that generation keeps hitting out of the page cache.
@@ -28,8 +31,9 @@ public:
         size_t        size;
     };
 
-    // true if any expert tensor of the model lives in host memory, the only weights re-uploaded at run time
-    static bool model_has_host_experts(const llama_model & model);
+    // true if any expert tensor of the model lives in a host mapping: the weights re-uploaded at run time whose
+    // pages can fault
+    static bool model_has_mapped_host_experts(const llama_model & model);
 
     // one pair of pinned buffers of buffer_size bytes per GPU backend that offers pinned memory
     llama_host_stager(const std::vector<ggml_backend_t> & backends, size_t buffer_size, int n_threads);
