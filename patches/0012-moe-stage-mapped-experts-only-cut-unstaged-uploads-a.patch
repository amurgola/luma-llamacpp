diff --git a/src/llama-moe-profile.cpp b/src/llama-moe-profile.cpp
index 1540d8e47..34a82f524 100644
--- a/src/llama-moe-profile.cpp
+++ b/src/llama-moe-profile.cpp
@@ -92,6 +92,27 @@ bool llama_moe_host_registry::contains(const void * p, size_t n) const {
     return begin >= it->begin && end <= it->end;
 }
 
+void llama_moe_host_registry::upload(ggml_backend_t backend, ggml_tensor * dst, size_t dst_offset, const void * src, size_t size) const {
+    const uintptr_t first = (uintptr_t) src;
+    const uintptr_t last  = first + size;
+
+    // the first range that ends past the start of the copy
+    auto it = std::upper_bound(ranges.begin(), ranges.end(), first, [](uintptr_t b, const range & r) { return b < r.end; });
+    for (uintptr_t cur = first; cur < last;) {
+        uintptr_t stop = last;
+        if (it != ranges.end()) {
+            if (cur < it->begin) {
+                stop = std::min(last, it->begin);
+            } else {
+                stop = std::min(last, it->end);
+                ++it;
+            }
+        }
+        ggml_backend_tensor_set_async(backend, dst, (const void *) cur, dst_offset + (cur - first), stop - cur);
+        cur = stop;
+    }
+}
+
 size_t llama_moe_host_registry::bytes() const {
     size_t n = 0;
     for (const range & r : ranges) {
