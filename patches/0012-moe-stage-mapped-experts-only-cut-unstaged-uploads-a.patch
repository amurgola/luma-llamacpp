+bool llama_model::is_mapped(const void * p) const {
+    for (const auto & mapping : pimpl->mappings) {
+        const uint8_t * addr = (const uint8_t *) mapping->addr();
+        if ((const uint8_t *) p >= addr && (const uint8_t *) p < addr + mapping->size()) {
+            return true;
+        }
+    }
+    return false;
+}
+
