+
+    // fill the empty cache with the most used experts of the profile, so the first tokens of the run hit
+    void seed() {
+        const int64_t t_start = ggml_time_us();
+        const auto ranked = profile->ranked();
+
+        size_t n_seeded = 0;
+        size_t bytes    = 0;
+        std::vector<std::vector<moe_cache_lru::fill>> per_layer(layers.size());
+        for (size_t ig = 0; ig < groups.size(); ++ig) {
+            group & g = groups[ig];
+            if (g.n_slots == 0) {
+                continue;
+            }
+
+            // the most used experts of the group's layers, up to its slots
+            std::vector<std::pair<int32_t, int32_t>> chosen;
+            for (const auto & le : ranked) {
+                if (chosen.size() >= (size_t) g.n_slots || profile->at(le.first, le.second) == 0) {
+                    break;
+                }
+                if (le.first < (int32_t) layers.size() && layers[le.first].ig == (int32_t) ig) {
+                    chosen.push_back(le);
+                }
+            }
+
+            // least used first, so the LRU evicts them first; the slots are all free, so nothing is evicted here
+            for (auto it = chosen.rbegin(); it != chosen.rend(); ++it) {
+                const int32_t il = it->first;
+                const int32_t e  = it->second;
+                size_t n_hit = 0;
+                if (g.lru.plan(il, &e, 1, fills, n_hit)) {
+                    per_layer[il].insert(per_layer[il].end(), fills.begin(), fills.end());
+                }
+            }
+
+            ggml_backend_t backend = devices[g.id].backend;
+            const bool staged = stager != nullptr && stager->enabled(backend);
+            for (int32_t il : g.layers) {
+                auto & lf = per_layer[il];
+                if (lf.empty()) {
+                    continue;
+                }
+                std::sort(lf.begin(), lf.end(), [](const moe_cache_lru::fill & a, const moe_cache_lru::fill & b) { return a.expert < b.expert; });
+                const layer & l = layers[il];
+                reqs.clear();
+                for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+                    const ggml_tensor * w    = l.experts[ip];
+                    ggml_tensor       * bank = g.banks[ip];
+                    const size_t expert_size = w->nb[2];
+                    for (const auto & f : lf) {
+                        if (staged) {
+                            reqs.push_back({ bank, f.slot*expert_size, (const uint8_t *) w->data + f.expert*expert_size, expert_size });
+                        } else {
+                            ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + f.expert*expert_size, f.slot*expert_size, expert_size);
+                        }
+                        bytes += expert_size;
+                    }
+                }
+                if (!reqs.empty()) {
+                    stager->upload(backend, reqs, /*low_priority=*/ false);
+                }
+                n_seeded += lf.size();
+            }
+            ggml_backend_synchronize(backend);
+        }
+
+        LLAMA_LOG_INFO("%s: seeded %zu experts (%.2f GiB) from the profile in %.2f s\n", __func__,
+            n_seeded, bytes/1024.0/1024.0/1024.0, (ggml_time_us() - t_start)/1e6);
+    }
+
+    bool is_cached(int32_t il, int32_t e) const {
+        if (il < 0 || il >= (int32_t) layers.size() || layers[il].ig < 0) {
+            return false;
+        }
+        const group & g = groups[layers[il].ig];
+        const int32_t * slots = g.lru.slot_map[il];
+        return slots != nullptr && e >= 0 && e < g.lru.n_expert && slots[e] >= 0;
+    }
+
+    void note_used(const ggml_tensor * w, const int32_t * ids, size_t n_ids) {
+        if (profile == nullptr) {
+            return;
+        }
+        const auto it = bindings.find(w);
+        if (it == bindings.end() || it->second.ip != 0) {
+            return; // one count per layer, on its first expert tensor
+        }
+        profile->note(it->second.il, ids, n_ids);
+        maybe_save();
+    }
+
+    void maybe_save() {
+        if (profile != nullptr && !profile_path.empty() && profile->n_unsaved >= save_every) {
+            profile->save(profile_path);
+        }
     }
 
     ggml_backend_t backend(int32_t il) const {
@@ -462,6 +575,9 @@ struct llama_moe_cache::impl {
 
