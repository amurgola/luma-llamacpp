+++ b/src/llama-moe-profile.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+// How often each expert of each layer was routed to, kept across runs in a small text file so that the next run can
+// place the experts before the first token is routed: the most used ones in the device cache, the next in locked RAM.
+struct llama_moe_profile {
+    int32_t n_layer  = 0;
+    int32_t n_expert = 0;
+
+    std::vector<uint64_t> counts; // [n_layer*n_expert]
+
+    // counts since the last save, so saves can be spaced by use
+    uint64_t n_unsaved = 0;
+
+    bool empty() const { return counts.empty(); }
+
+    void init(int32_t n_layer, int32_t n_expert);
+
+    uint64_t   at(int32_t il, int32_t e) const { return counts[(size_t) il*n_expert + e]; }
+    uint64_t & at(int32_t il, int32_t e)       { return counts[(size_t) il*n_expert + e]; }
+
+    // count one routing of each id in layer il; counts are halved when one of them gets large, so old runs fade
+    void note(int32_t il, const int32_t * ids, size_t n_ids);
+
+    // (layer, expert) pairs by count, most used first; ties keep the layer then expert order
+    std::vector<std::pair<int32_t, int32_t>> ranked() const;
+
+    // false if the file is missing, unreadable or shaped for another model; the profile is then left empty
+    bool load(const std::string & path, int32_t n_layer, int32_t n_expert);
+
+    // written to a temporary file first, so a crash mid-write keeps the previous profile
+    bool save(const std::string & path);
+
+    static constexpr uint64_t max_count = 1ull << 40;
+};
