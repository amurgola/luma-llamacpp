diff --git a/src/llama-moe-profile.cpp b/src/llama-moe-profile.cpp
new file mode 100644
index 000000000..d346775dd
--- /dev/null
+++ b/src/llama-moe-profile.cpp
@@ -0,0 +1,110 @@
+#include "llama-moe-profile.h"
+
+#include "llama-impl.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <fstream>
+#include <numeric>
+#include <sstream>
+
+void llama_moe_profile::init(int32_t n_layer, int32_t n_expert) {
+    this->n_layer  = n_layer;
+    this->n_expert = n_expert;
+    counts.assign((size_t) n_layer*n_expert, 0);
+    n_unsaved = 0;
+}
+
+void llama_moe_profile::note(int32_t il, const int32_t * ids, size_t n_ids) {
+    if (il < 0 || il >= n_layer) {
+        return;
+    }
+    uint64_t * row = counts.data() + (size_t) il*n_expert;
+    bool large = false;
+    for (size_t i = 0; i < n_ids; ++i) {
+        if (ids[i] >= 0 && ids[i] < n_expert) {
+            large |= ++row[ids[i]] >= max_count;
+        }
+    }
+    n_unsaved += n_ids;
+    if (large) {
+        for (uint64_t & c : counts) {
+            c >>= 1;
+        }
+    }
+}
+
+std::vector<std::pair<int32_t, int32_t>> llama_moe_profile::ranked() const {
+    std::vector<std::pair<int32_t, int32_t>> res;
+    res.reserve(counts.size());
+    for (int32_t il = 0; il < n_layer; ++il) {
+        for (int32_t e = 0; e < n_expert; ++e) {
+            res.emplace_back(il, e);
+        }
+    }
+    std::stable_sort(res.begin(), res.end(), [this](const auto & a, const auto & b) {
+        return at(a.first, a.second) > at(b.first, b.second);
+    });
+    return res;
+}
+
+bool llama_moe_profile::load(const std::string & path, int32_t n_layer, int32_t n_expert) {
+    init(n_layer, n_expert);
+    std::ifstream in(path);
+    if (!in) {
+        return false;
+    }
+    std::string magic;
+    int version = 0;
+    int32_t file_layers = 0;
+    int32_t file_experts = 0;
+    in >> magic >> version >> file_layers >> file_experts;
+    if (!in || magic != "llama_moe_profile" || version != 1 || file_layers != n_layer || file_experts != n_expert) {
+        LLAMA_LOG_WARN("%s: ignoring profile %s: it is not for this model (%d layers x %d experts)\n", __func__, path.c_str(), n_layer, n_expert);
+        return false;
+    }
+    for (uint64_t & c : counts) {
+        in >> c;
+        if (!in) {
+            LLAMA_LOG_WARN("%s: ignoring profile %s: truncated\n", __func__, path.c_str());
+            init(n_layer, n_expert);
+            return false;
+        }
+    }
+    const uint64_t total = std::accumulate(counts.begin(), counts.end(), (uint64_t) 0);
+    LLAMA_LOG_INFO("%s: loaded profile %s: %llu routings over %d layers x %d experts\n", __func__, path.c_str(),
+        (unsigned long long) total, n_layer, n_expert);
+    return true;
+}
+
+bool llama_moe_profile::save(const std::string & path) {
+    if (empty()) {
+        return false;
+    }
+    const std::string tmp = path + ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::trunc);
+        if (!out) {
+            LLAMA_LOG_WARN("%s: cannot write profile %s\n", __func__, tmp.c_str());
+            return false;
+        }
+        out << "llama_moe_profile 1 " << n_layer << ' ' << n_expert << '\n';
+        for (int32_t il = 0; il < n_layer; ++il) {
+            const uint64_t * row = counts.data() + (size_t) il*n_expert;
+            for (int32_t e = 0; e < n_expert; ++e) {
+                out << row[e] << (e + 1 < n_expert ? ' ' : '\n');
+            }
+        }
+        if (!out) {
+            LLAMA_LOG_WARN("%s: cannot write profile %s\n", __func__, tmp.c_str());
+            return false;
+        }
+    }
+    std::remove(path.c_str());
+    if (std::rename(tmp.c_str(), path.c_str()) != 0) {
+        LLAMA_LOG_WARN("%s: cannot replace profile %s\n", __func__, path.c_str());
+        return false;
+    }
+    n_unsaved = 0;
+    return true;
+}
