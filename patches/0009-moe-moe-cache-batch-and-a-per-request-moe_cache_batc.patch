     std::string moe_profile; // path of the expert use profile kept across runs (empty = none)
     size_t moe_ram_size = 0; // bytes of the MoE experts kept in the CPU to lock in RAM, the most used first when a profile exists
+    int32_t moe_cache_batch = 32; // largest prompt batch (tokens) served by the MoE cache, larger ones stage a layer's experts instead
 
     common_conversation_mode conversation_mode = COMMON_CONVERSATION_MODE_AUTO;
 
diff --git a/include/llama.h b/include/llama.h
index f7580e4c0..4d7836e26 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -400,6 +400,7 @@ extern "C" {
         size_t moe_stage_size; // pinned staging bytes per buffer (two per device) for the uploads of host experts, 0 = unstaged copies [EXPERIMENTAL]
         const char * moe_profile; // path of the expert use profile: read to seed the MoE cache, written as the experts are routed, NULL = none [EXPERIMENTAL]
         size_t moe_ram_size; // bytes of host experts locked in RAM at creation, the most used first when a profile exists, 0 = none [EXPERIMENTAL]
+        int32_t moe_cache_batch; // largest ubatch (tokens) the MoE cache serves, larger ones stage the experts of a layer instead (default 32) [EXPERIMENTAL]
 
         // Abort callback
         // if it returns true, execution of llama_decode() will be aborted
@@ -1116,6 +1117,9 @@ extern "C" {
     // If set to true, the model will only attend to the past tokens
     LLAMA_API void llama_set_causal_attn(struct llama_context * ctx, bool causal_attn);
 
+    // Set the largest ubatch the MoE cache serves (see llama_context_params.moe_cache_batch), for the next decodes
+    LLAMA_API void llama_set_moe_cache_batch(struct llama_context * ctx, int32_t n_tokens);
+
     // Returns whether the context is currently using causal attention
     LLAMA_API bool llama_get_causal_attn(const struct llama_context * ctx);
 
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 8da2e3bdc..853ac0ae2 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -362,6 +362,7 @@ llama_context::llama_context(
     cparams.moe_cache_size = params.moe_cache_size;
     cparams.moe_stage_size = params.moe_stage_size;
     cparams.moe_ram_size   = params.moe_ram_size;
+    cparams.moe_cache_batch = std::max<int32_t>(1, params.moe_cache_batch);
 
     // initialized later
     cparams.pipeline_parallel = false;
@@ -563,6 +564,7 @@ llama_context::llama_context(
         if (cparams.moe_cache_size > 0) {
             moe_cache = std::make_unique<llama_moe_cache>(model, backend_ptrs, backend_buft, cparams.moe_cache_size, host_stager.get(),
                 params.moe_profile != nullptr && params.moe_profile[0] != 0 ? &moe_profile : nullptr, params.moe_profile);
+            moe_cache->set_max_batch(cparams.moe_cache_batch);
         }
 
         // the RAM tier below the device cache: the experts the cache does not hold, the most used first
@@ -1351,6 +1353,21 @@ void llama_context::set_embeddings(bool value) {
     cparams.embeddings = value;
 }
 
+void llama_context::set_moe_cache_batch(int32_t n_tokens) {
+    n_tokens = std::max<int32_t>(1, n_tokens);
+    if (cparams.moe_cache_batch == n_tokens) {
+        return;
+    }
+    LLAMA_LOG_DEBUG("%s: n_tokens = %d\n", __func__, n_tokens);
+
+    cparams.moe_cache_batch = n_tokens;
+    if (moe_cache) {
+        moe_cache->set_max_batch(n_tokens);
+        // the limit decides whether a ubatch reads the slot maps, so a kept graph may be the wrong shape
+        gf_res_prev_active = nullptr;
+    }
+}
+
 void llama_context::set_embeddings_nextn(bool value, bool masked) {
     LLAMA_LOG_DEBUG("%s: value = %d, masked = %d\n", __func__, value, masked);
 
@@ -4055,6 +4072,7 @@ llama_context_params llama_context_default_params() {
         /*.moe_stage_size              =*/ 128u*1024*1024,
         /*.moe_profile                 =*/ nullptr,
         /*.moe_ram_size                =*/ 0,
+        /*.moe_cache_batch             =*/ 32,
         /*.abort_callback              =*/ nullptr,
         /*.abort_callback_data         =*/ nullptr,
         /*.embeddings                  =*/ false,
@@ -4256,6 +4274,10 @@ void llama_set_causal_attn(llama_context * ctx, bool causal_attn) {
     ctx->set_causal_attn(causal_attn);
 }
 
+void llama_set_moe_cache_batch(llama_context * ctx, int32_t n_tokens) {
+    ctx->set_moe_cache_batch(n_tokens);
+}
+
 bool llama_get_causal_attn(const llama_context * ctx) {
     return ctx->get_causal_attn();
 }
