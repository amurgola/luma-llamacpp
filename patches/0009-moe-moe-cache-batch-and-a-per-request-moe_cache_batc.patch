@@ -1748,6 +1748,7 @@ struct llama_context_params common_context_params_to_llama(const common_params &
     cparams.moe_stage_size = params.moe_stage_size;
     cparams.moe_profile    = params.moe_profile.empty() ? nullptr : params.moe_profile.c_str();
     cparams.moe_ram_size   = params.moe_ram_size;
