 common/common.cpp               |  1 +
 common/common.h                 |  1 +
 include/llama.h                 |  4 ++++
 src/llama-context.cpp           | 22 ++++++++++++++++++++++
 src/llama-context.h             |  1 +
 src/llama-cparams.h             |  1 +
 src/llama-moe-cache.cpp         |  6 +++++-
 src/llama-moe-cache.h           |  3 +++
 tools/server/server-context.cpp |  4 ++++
 tools/server/server-schema.cpp  |  4 ++++
 tools/server/server-task.cpp    |  2 ++
 tools/server/server-task.h      |  2 ++
 13 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index 49c81565c..68fd17cb3 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2814,6 +2814,16 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.moe_ram_size = (size_t) value*1024*1024;
         }
     ).set_env("LLAMA_ARG_MOE_RAM_MIB"));
+    add_opt(common_arg(
+        {"--moe-cache-batch"}, "N",
+        "largest prompt batch in tokens served by the MoE cache; larger batches stage every expert of a layer through the GPU instead, which reads the whole expert pool (default: 32). a request can override it with moe_cache_batch",
+        [](common_params & params, int value) {
+            if (value < 1) {
+                throw std::invalid_argument("invalid value");
+            }
+            params.moe_cache_batch = value;
+        }
+    ).set_env("LLAMA_ARG_MOE_CACHE_BATCH"));
     add_opt(common_arg(
         {"-ncffn", "--n-cpu-ffn"}, "N",
         "keep the dense FFN weights of the first N layers in the CPU\n"
