index 000000000..aac761a38
--- /dev/null
+++ b/src/llama-host-stager.cpp
@@ -0,0 +1,423 @@
+#include "llama-host-stager.h"
+
+#include "llama-impl.h"
+#include "llama-mmap.h"
+#include "llama-model.h"
+
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <functional>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+
+#if defined(_WIN32)
+#   define WIN32_LEAN_AND_MEAN
+#   ifndef NOMINMAX
+#       define NOMINMAX
+#   endif
+#   include <windows.h>
+#elif defined(__linux__)
+#   include <sys/mman.h>
+#   include <unistd.h>
+#   ifndef MADV_COLD
+#       define MADV_COLD 20
+#   endif
+#endif
+
+namespace {
+
+// the memory priority of a thread is the standby priority of the pages it faults in: pages read at a low priority
+// are repurposed before the pages read at the normal one
+void llama_host_stager_set_memory_priority(bool low) {
+#if defined(_WIN32)
+    using set_thread_information_t = BOOL (WINAPI *)(HANDLE, int, LPVOID, DWORD);
+    static const auto pSetThreadInformation = (set_thread_information_t) (void *) GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadInformation");
+    if (!pSetThreadInformation) {
+        return;
+    }
+    thread_local int current = -1;
+    const int wanted = low ? 1 : 5; // MEMORY_PRIORITY_VERY_LOW : MEMORY_PRIORITY_NORMAL
+    if (current == wanted) {
+        return;
+    }
+    struct { ULONG MemoryPriority; } info = { (ULONG) wanted };
+    if (pSetThreadInformation(GetCurrentThread(), 0 /* ThreadMemoryPriority */, &info, sizeof(info))) {
+        current = wanted;
+    }
+#else
+    GGML_UNUSED(low);
+#endif
+}
+
+// after a low priority copy on POSIX, hand the source pages back to the OS as the first to reclaim
+void llama_host_stager_release_pages(const void * src, size_t size) {
+#if defined(__linux__)
+    static const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    const uintptr_t first = (uintptr_t) src / page * page;
+    const uintptr_t last  = ((uintptr_t) src + size + page - 1) / page * page;
+    if (last > first) {
+        madvise((void *) first, last - first, MADV_COLD);
+    }
+#else
+    GGML_UNUSED(src);
+    GGML_UNUSED(size);
+#endif
+}
+
+struct llama_host_stager_piece {
+    const uint8_t * src;
+    uint8_t       * dst;
+    size_t          size;
+};
+
+// a small pool of copy threads; the caller runs pieces too
+struct llama_host_stager_pool {
+    std::vector<std::thread> workers;
+    std::mutex mutex;
+    std::condition_variable cv_work;
+    std::condition_variable cv_done;
+    uint64_t generation = 0;
+    int n_busy = 0;
+    bool stop = false;
+
+    const std::vector<llama_host_stager_piece> * pieces = nullptr;
+    std::atomic<size_t> next{0};
+    bool low_priority = false;
+
+    explicit llama_host_stager_pool(int n_threads) {
+        for (int t = 0; t < n_threads - 1; ++t) {
+            workers.emplace_back([this] { worker(); });
+        }
+    }
+
+    ~llama_host_stager_pool() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+        }
+        cv_work.notify_all();
+        for (auto & w : workers) {
+            w.join();
+        }
+    }
+
+    void copy_pieces() {
+        llama_host_stager_set_memory_priority(low_priority);
+        for (size_t i = next.fetch_add(1); i < pieces->size(); i = next.fetch_add(1)) {
+            const auto & p = (*pieces)[i];
+            memcpy(p.dst, p.src, p.size);
+            if (low_priority) {
+                llama_host_stager_release_pages(p.src, p.size);
+            }
+        }
+    }
+
+    void worker() {
+        uint64_t seen = 0;
+        while (true) {
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                cv_work.wait(lock, [&] { return stop || generation != seen; });
+                if (stop) {
+                    return;
+                }
+                seen = generation;
+            }
+            copy_pieces();
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                if (--n_busy == 0) {
+                    cv_done.notify_all();
+                }
+            }
+        }
+    }
+
+    void run(const std::vector<llama_host_stager_piece> & ps, bool low) {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            pieces       = &ps;
+            low_priority = low;
+            next         = 0;
+            n_busy       = (int) workers.size();
+            generation++;
+        }
+        cv_work.notify_all();
+        copy_pieces();
+        std::unique_lock<std::mutex> lock(mutex);
+        cv_done.wait(lock, [&] { return n_busy == 0; });
+    }
+};
+
+}
+
+struct llama_host_stager::impl {
+    struct device {
+        ggml_backend_t backend = nullptr;
+        ggml_backend_buffer_ptr bufs[2];
+        uint8_t * base[2] = { nullptr, nullptr };
+        ggml_backend_event_t events[2] = { nullptr, nullptr };
+        bool pending[2] = { false, false };
+        int next = 0;
+    };
+
+    // one piece per thread hop: large enough to amortize the hand-off, small enough to balance the threads
+    static constexpr size_t piece_size = 2u*1024*1024;
+
+    // pages to read ahead of the copy threads, in staging buffers
+    static constexpr int prefetch_ahead = 2;
+
+    size_t buffer_size;
+    std::vector<device> devices;
+    llama_host_stager_pool pool;
+
+    struct dma {
+        ggml_tensor * dst;
+        size_t dst_offset;
+        size_t stage_offset;
+        size_t size;
+    };
+
+    // one fill of a staging buffer
+    struct window {
+        std::vector<llama_host_stager_piece> pieces;
+        std::vector<dma> dmas;
+        std::vector<request> sources;
+    };
+
+    std::vector<window> windows;
+
+    struct stats {
+        size_t  bytes = 0;
+        int64_t t_us  = 0;
+        size_t  n     = 0;
+    };
+
+    stats stats_low;
+    stats stats_normal;
+
+    impl(const std::vector<ggml_backend_t> & backends, size_t buffer_size, int n_threads) :
+            buffer_size(buffer_size), pool(std::max(1, n_threads)) {
+        for (ggml_backend_t backend : backends) {
+            ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+            if (dev == nullptr) {
+                continue;
+            }
+            const auto dev_type = ggml_backend_dev_type(dev);
+            if (dev_type != GGML_BACKEND_DEVICE_TYPE_GPU && dev_type != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+                continue;
+            }
+            ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(dev);
+            if (buft == nullptr) {
+                continue;
+            }
+            device d;
+            d.backend = backend;
+            bool ok = true;
+            for (int k = 0; k < 2 && ok; ++k) {
+                d.bufs[k].reset(ggml_backend_buft_alloc_buffer(buft, buffer_size));
+                if (!d.bufs[k]) {
+                    ok = false;
+                    break;
+                }
+                d.base[k] = (uint8_t *) ggml_backend_buffer_get_base(d.bufs[k].get());
+                d.events[k] = ggml_backend_event_new(dev);
+            }
+            if (!ok) {
+                LLAMA_LOG_WARN("%s: could not allocate %zu MiB of pinned memory for %s, uploads stay unstaged\n",
+                    __func__, 2*buffer_size/1024/1024, ggml_backend_dev_name(dev));
+                for (int k = 0; k < 2; ++k) {
+                    if (d.events[k]) {
+                        ggml_backend_event_free(d.events[k]);
+                    }
+                }
+                continue;
+            }
+            devices.push_back(std::move(d));
+            LLAMA_LOG_INFO("%s: %10s staging buffers = %8.2f MiB (%d copy threads)\n", __func__,
+                ggml_backend_buft_name(buft), 2*buffer_size/1024.0/1024.0, std::max(1, n_threads));
+        }
+    }
+
+    ~impl() {
+        for (device & d : devices) {
+            for (int k = 0; k < 2; ++k) {
+                if (d.pending[k]) {
+                    if (d.events[k]) {
+                        ggml_backend_event_synchronize(d.events[k]);
+                    } else {
+                        ggml_backend_synchronize(d.backend);
+                    }
+                }
+                if (d.events[k]) {
+                    ggml_backend_event_free(d.events[k]);
+                }
+            }
+        }
+        auto log = [](const char * name, const stats & st) {
+            if (st.n == 0) {
+                return;
+            }
+            LLAMA_LOG_INFO("llama_host_stager: %s: %zu uploads, %.2f GiB in %.2f s (%.2f GB/s)\n",
+                name, st.n, st.bytes/1024.0/1024.0/1024.0, st.t_us/1e6, st.t_us > 0 ? st.bytes/1e3/st.t_us : 0.0);
+        };
+        log("generation (normal priority)", stats_normal);
+        log("large batches (low priority) ", stats_low);
+    }
+
+    device * find(ggml_backend_t backend) {
+        for (device & d : devices) {
+            if (d.backend == backend) {
+                return &d;
+            }
+        }
+        return nullptr;
+    }
+
+    // cut the requests into staging buffer fills
+    void plan(const std::vector<request> & reqs, uint8_t * const bases[2]) {
+        windows.clear();
+        size_t ir = 0;
+        size_t roff = 0;
+        while (ir < reqs.size()) {
+            windows.emplace_back();
+            window & w = windows.back();
+            uint8_t * base = bases[windows.size() % 2 == 1 ? 0 : 1];
+            size_t fill = 0;
+            while (ir < reqs.size() && fill < buffer_size) {
+                const request & r = reqs[ir];
+                if (r.size == 0) {
+                    ir++;
+                    continue;
+                }
+                const size_t n = std::min(r.size - roff, buffer_size - fill);
+                w.dmas.push_back({ r.dst, r.dst_offset + roff, fill, n });
+                w.sources.push_back({ nullptr, 0, (const uint8_t *) r.src + roff, n });
+                for (size_t p = 0; p < n; p += piece_size) {
+                    w.pieces.push_back({ (const uint8_t *) r.src + roff + p, base + fill + p, std::min(piece_size, n - p) });
+                }
+                fill += n;
+                roff += n;
+                if (roff == r.size) {
+                    ir++;
+                    roff = 0;
+                }
+            }
+        }
+    }
+
+    void upload(ggml_backend_t backend, const std::vector<request> & reqs, bool low) {
+        device * d = find(backend);
+        GGML_ASSERT(d != nullptr);
+
+        const int64_t t_start = ggml_time_us();
+
+        // the prefetches below are issued at this priority too
+        llama_host_stager_set_memory_priority(low);
+
+        // fills alternate between the two buffers from the one that is free next
+        uint8_t * bases[2] = { d->base[d->next], d->base[d->next ^ 1] };
+        plan(reqs, bases);
+
+        size_t bytes = 0;
+        for (size_t iw = 0; iw < windows.size(); ++iw) {
+            if (iw == 0) {
+                for (int a = 0; a < prefetch_ahead && (size_t) a < windows.size(); ++a) {
+                    prefetch(windows[a].sources);
+                }
+            } else if (iw + prefetch_ahead - 1 < windows.size()) {
+                prefetch(windows[iw + prefetch_ahead - 1].sources);
+            }
+
+            const int k = d->next;
+            d->next ^= 1;
+
+            // the DMA that last read this buffer must be done before it is overwritten
+            if (d->pending[k]) {
+                if (d->events[k]) {
+                    ggml_backend_event_synchronize(d->events[k]);
+                } else {
+                    ggml_backend_synchronize(backend);
+                }
+                d->pending[k] = false;
+            }
+
+            window & w = windows[iw];
+            pool.run(w.pieces, low);
+            for (const dma & m : w.dmas) {
+                ggml_backend_tensor_set_async(backend, m.dst, d->base[k] + m.stage_offset, m.dst_offset, m.size);
+                bytes += m.size;
+            }
+            if (d->events[k]) {
+                ggml_backend_event_record(d->events[k], backend);
+            }
+            d->pending[k] = true;
+        }
+
+        llama_host_stager_set_memory_priority(false);
+
+        stats & st = low ? stats_low : stats_normal;
+        st.bytes += bytes;
+        st.t_us  += ggml_time_us() - t_start;
+        st.n++;
+    }
+};
+
+bool llama_host_stager::model_has_host_experts(const llama_model & model) {
+    for (const auto & layer : model.layers) {
+        for (const ggml_tensor * t : { layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps }) {
+            if (t != nullptr && t->buffer != nullptr &&
+                    ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+                    ggml_backend_buffer_is_host(t->buffer)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+llama_host_stager::llama_host_stager(const std::vector<ggml_backend_t> & backends, size_t buffer_size, int n_threads) :
+    pimpl(new impl(backends, buffer_size, n_threads)) {
+}
+
+llama_host_stager::~llama_host_stager() = default;
+
+bool llama_host_stager::enabled(ggml_backend_t backend) const {
+    return pimpl->find(backend) != nullptr;
+}
+
+size_t llama_host_stager::buffer_size() const {
+    return pimpl->buffer_size;
+}
+
+void llama_host_stager::upload(ggml_backend_t backend, const std::vector<request> & reqs, bool low_priority) {
+    pimpl->upload(backend, reqs, low_priority);
+}
+
+void llama_host_stager::prefetch(const std::vector<request> & reqs) {
+    llama_memory_ranges mr;
+    mr.reserve(reqs.size());
+    for (const request & r : reqs) {
+        if (r.src != nullptr && r.size > 0) {
+            mr.push_back({ r.src, r.size });
+        }
+    }
+    llama_prefetch(std::move(mr));
+}
+
+std::map<ggml_backend_buffer_type_t, size_t> llama_host_stager::memory_breakdown() const {
+    std::map<ggml_backend_buffer_type_t, size_t> res;
+    for (const auto & d : pimpl->devices) {
+        for (int k = 0; k < 2; ++k) {
+            if (d.bufs[k]) {
+                res[ggml_backend_buffer_get_type(d.bufs[k].get())] += ggml_backend_buffer_get_size(d.bufs[k].get());
+            }
+        }
+    }
+    return res;
+}
