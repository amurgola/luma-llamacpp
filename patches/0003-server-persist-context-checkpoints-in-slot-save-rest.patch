From de0b19b0e45d6f16907dd40e40316359336d062e Mon Sep 17 00:00:00 2001
From: Andrew Murgola <andy@murgo.la>
Date: Thu, 3 Sep 2026 17:16:46 -0400
Subject: [PATCH] server: persist context checkpoints in slot save/restore

/slots/{id}?action=restore was useless for SWA and hybrid-attention
models across a server restart: the state file carries the sequence KV
and tokens, but not the context checkpoints, and without one the resume
gate in update_slots() forces full prompt re-processing (windowed layers
only hold the last attention window). Restoring a 5.7k-token Qwen3.8
slot reprocessed all 5774 tokens despite the slot reporting a perfect
prefix match.

Persist the checkpoints in a versioned sidecar (<slot file>.ckpt) so the
upstream llama_state_seq_save_file format is untouched. A missing
sidecar (older saves) degrades to the previous behavior; an invalid one
is discarded with a warning. Save/restore responses now report
n_checkpoints so callers can verify resumability.

Measured (Qwen3.8-27B hybrid-attention, 5774-token prompt, RTX 5090,
across a full server restart): next identical request went from
prompt_n = 5774 / ~2.0 s to prompt_n = 4 / 93 ms, identical output.
Sidecar cost: 299 MiB, written in the existing save call (452 ms total),
restored in 356 ms. Dense models are unaffected (they resume without
checkpoints either way).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TRNybKMfE2D3yiS9yXLBfe
---
 tools/server/server-context.cpp | 116 ++++++++++++++++++++++++++++++++
 tools/server/server-task.cpp    |  18 ++---
 tools/server/server-task.h      |   4 ++
 3 files changed, 130 insertions(+), 8 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index f78cfb3..ef3bdac 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -38,6 +38,106 @@
 
 constexpr int HTTP_POLLING_SECONDS = 1;
 
+// Context-checkpoint sidecar for slot save/restore (<slot file>.ckpt).
+//
+// SWA and hybrid-attention models cannot resume a restored sequence at an
+// arbitrary position without a context checkpoint: their windowed layers only
+// hold the last attention window, so the resume gate in update_slots() falls
+// back to full prompt re-processing when no checkpoint covers the position
+// ("forcing full prompt re-processing due to lack of cache data"). The main
+// slot file (llama_state_seq_save_file) does not carry checkpoints, which
+// made /slots/{id}?action=restore useless for such models across a server
+// restart. The sidecar persists them without touching the upstream state
+// file format. A missing sidecar (older saves) degrades to the previous
+// behavior; an invalid one is discarded with a warning.
+static constexpr uint32_t SLOT_CKPT_MAGIC   = 0x504B434Cu; // 'LCKP'
+static constexpr uint32_t SLOT_CKPT_VERSION = 1u;
+
+static bool server_slot_save_checkpoints(const std::string & filepath, const std::list<common_prompt_checkpoint> & checkpoints) {
+    const std::string path = filepath + ".ckpt";
+
+    if (checkpoints.empty()) {
+        // never leave a stale sidecar next to a fresh save
+        std::remove(path.c_str());
+        return true;
+    }
+
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) {
+        return false;
+    }
+
+    auto wr = [&out](const void * p, size_t n) { out.write(reinterpret_cast<const char *>(p), n); };
+    auto wr_blob = [&](const std::vector<uint8_t> & v) {
+        const uint64_t n = v.size();
+        wr(&n, sizeof(n));
+        if (n > 0) {
+            wr(v.data(), n);
+        }
+    };
+
+    const uint32_t count = (uint32_t) checkpoints.size();
+    wr(&SLOT_CKPT_MAGIC,   sizeof(SLOT_CKPT_MAGIC));
+    wr(&SLOT_CKPT_VERSION, sizeof(SLOT_CKPT_VERSION));
+    wr(&count, sizeof(count));
+
+    for (const auto & ckpt : checkpoints) {
+        wr(&ckpt.n_tokens, sizeof(ckpt.n_tokens));
+        wr(&ckpt.pos_min,  sizeof(ckpt.pos_min));
+        wr(&ckpt.pos_max,  sizeof(ckpt.pos_max));
+        wr_blob(ckpt.data_tgt);
+        wr_blob(ckpt.data_dft);
+        wr_blob(ckpt.data_spec);
+    }
+
+    return out.good();
+}
+
+static bool server_slot_load_checkpoints(const std::string & filepath, std::list<common_prompt_checkpoint> & checkpoints) {
+    checkpoints.clear();
+
+    const std::string path = filepath + ".ckpt";
+
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        // no sidecar: an older save - restore proceeds without checkpoints
+        return true;
+    }
+
+    auto rd = [&in](void * p, size_t n) { in.read(reinterpret_cast<char *>(p), n); return in.good(); };
+    auto rd_blob = [&](std::vector<uint8_t> & v) {
+        uint64_t n = 0;
+        if (!rd(&n, sizeof(n)) || n > (1ull << 33)) { // 8 GiB per-blob sanity cap
+            return false;
+        }
+        v.resize(n);
+        return n == 0 || rd(v.data(), n);
+    };
+
+    uint32_t magic = 0, version = 0, count = 0;
+    if (!rd(&magic, sizeof(magic)) || magic != SLOT_CKPT_MAGIC ||
+        !rd(&version, sizeof(version)) || version != SLOT_CKPT_VERSION ||
+        !rd(&count, sizeof(count)) || count > 1024) {
+        return false;
+    }
+
+    for (uint32_t i = 0; i < count; ++i) {
+        common_prompt_checkpoint ckpt;
+        if (!rd(&ckpt.n_tokens, sizeof(ckpt.n_tokens)) ||
+            !rd(&ckpt.pos_min,  sizeof(ckpt.pos_min))  ||
+            !rd(&ckpt.pos_max,  sizeof(ckpt.pos_max))  ||
+            !rd_blob(ckpt.data_tgt) ||
+            !rd_blob(ckpt.data_dft) ||
+            !rd_blob(ckpt.data_spec)) {
+            checkpoints.clear();
+            return false;
+        }
+        checkpoints.push_back(std::move(ckpt));
+    }
+
+    return true;
+}
+
 static common_speculative_output_limits server_output_limits(const common_params & params) {
     if (params.embedding ||
             (params.pooling_type != LLAMA_POOLING_TYPE_UNSPECIFIED && params.pooling_type != LLAMA_POOLING_TYPE_NONE)) {
@@ -2563,6 +2663,13 @@ private:
                         break;
                     }
 
+                    // Persist the context checkpoints alongside the state file -
+                    // without them, restoring into an SWA/hybrid-attention model
+                    // forces full prompt re-processing (see the sidecar helpers).
+                    if (!server_slot_save_checkpoints(filepath, slot->prompt.checkpoints)) {
+                        SLT_WRN(*slot, "failed to write context checkpoint sidecar for %s\n", filename.c_str());
+                    }
+
                     const int64_t t_end = ggml_time_us();
                     const double t_save_ms = (t_end - t_start) / 1000.0;
 
@@ -2574,6 +2681,7 @@ private:
                     res->n_tokens = slot->prompt.tokens.size();
                     res->n_bytes  = nwrite;
                     res->t_ms     = t_save_ms;
+                    res->n_checkpoints = slot->prompt.checkpoints.size();
                     queue_results.send(std::move(res));
                 } break;
             case SERVER_TASK_TYPE_SLOT_RESTORE:
@@ -2622,6 +2730,13 @@ private:
 
                         slot->prompt.clear();
                         slot->prompt.tokens = std::move(restored);
+
+                        // Bring back the context checkpoints saved with this
+                        // state, so SWA/hybrid-attention models can resume the
+                        // restored sequence instead of re-processing it.
+                        if (!server_slot_load_checkpoints(filepath, slot->prompt.checkpoints)) {
+                            SLT_WRN(*slot, "invalid context checkpoint sidecar for %s - continuing without checkpoints\n", filename.c_str());
+                        }
                     } catch (const std::exception & err) {
                         slot->prompt_clear();
                         send_error(task, std::string("Unable to restore slot: ") + err.what(), ERROR_TYPE_INVALID_REQUEST);
@@ -2639,6 +2754,7 @@ private:
                     res->n_tokens = slot->prompt.tokens.size();
                     res->n_bytes  = nread;
                     res->t_ms     = t_restore_ms;
+                    res->n_checkpoints = slot->prompt.checkpoints.size();
                     queue_results.send(std::move(res));
                 } break;
             case SERVER_TASK_TYPE_SLOT_ERASE:
diff --git a/tools/server/server-task.cpp b/tools/server/server-task.cpp
index 0d3beb3..1324496 100644
--- a/tools/server/server-task.cpp
+++ b/tools/server/server-task.cpp
@@ -1622,10 +1622,11 @@ std::string server_task_result_metrics::to_metrics() {
 json server_task_result_slot_save_load::to_json() {
     if (is_save) {
         return json {
-            { "id_slot",   id_slot },
