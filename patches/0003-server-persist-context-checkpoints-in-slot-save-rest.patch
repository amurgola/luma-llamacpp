+            { "n_written",     n_bytes },
+            { "n_checkpoints", n_checkpoints },
             { "timings", {
                 { "save_ms", t_ms }
             }},
@@ -1633,10 +1634,11 @@ json server_task_result_slot_save_load::to_json() {
     }
 
     return json {
-        { "id_slot",    id_slot },
-        { "filename",   filename },
-        { "n_restored", n_tokens },
-        { "n_read",     n_bytes },
+        { "id_slot",       id_slot },
+        { "filename",      filename },
+        { "n_restored",    n_tokens },
+        { "n_read",        n_bytes },
+        { "n_checkpoints", n_checkpoints },
         { "timings", {
             { "restore_ms", t_ms }
         }},
diff --git a/tools/server/server-task.h b/tools/server/server-task.h
index 9c99143..4a43e47 100644
--- a/tools/server/server-task.h
+++ b/tools/server/server-task.h
@@ -526,6 +526,10 @@ struct server_task_result_slot_save_load : server_task_result {
     size_t n_bytes;
     double t_ms;
 
+    // context checkpoints persisted/restored via the sidecar file - lets
+    // callers verify that an SWA/hybrid model will actually resume
+    size_t n_checkpoints = 0;
+
     virtual json to_json() override;
 };
 
