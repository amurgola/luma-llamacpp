From 940b609e7133626e34cf582af48e45e465d5f5a9 Mon Sep 17 00:00:00 2001
From: Andrew Murgola <andy@murgo.la>
Date: Thu, 3 Sep 2026 17:38:28 -0400
Subject: [PATCH 1/2] llama: overlap vocab construction with tensor loading

Vocab construction (BPE merges map, token attributes, token-to-piece
cache) costs ~1.9s on a 250k-token vocab and runs serially before
load_tensors, which is I/O + DMA bound - the CPU sits idle either way.
Run vocab.load() on a worker thread while the weights stream to the
device.

The only load-path consumer of the vocab is the token count in tensor
shapes (LLAMA_LOAD_LOCALS n_vocab): pre-read it from the gguf metadata
(tokenizer.ggml.tokens array length, O(1)) into n_vocab_hint so
load_tensors never touches the concurrently-building vocab. The worker
only performs pure metadata reads (get_key/get_arr over the parsed
gguf_context); tensor bookkeeping state is disjoint. print_info() joins
the worker first; models without a token list fall back to the serial
path unchanged.

Measured (Qwen3.8-27B, 248k vocab, warm cache, RTX 5090, --fit off,
load-mode mmap): load-to-healthy 5.7s -> 4.7s; tokenization and greedy
completion outputs identical.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TRNybKMfE2D3yiS9yXLBfe
---
 src/llama-model.h |  9 ++++++-
 src/llama.cpp     | 62 +++++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 65 insertions(+), 6 deletions(-)

diff --git a/src/llama-model.h b/src/llama-model.h
index 4c4a30e..5fef0fe 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -615,6 +615,13 @@ struct llama_model {
     llama_hparams hparams = {};
     llama_vocab   vocab;
 
+    // Token count pre-read from gguf metadata (tokenizer.ggml.tokens array
+    // length) so tensor shapes (LLAMA_LOAD_LOCALS' n_vocab) do not need the
+    // fully built vocab — which lets the expensive vocab construction run on
+    // a worker thread while load_tensors streams the weights. 0 = not read;
+    // the macro then falls back to vocab.n_tokens() (serial load path).
+    int64_t n_vocab_hint = 0;
+
     // for classifier models
     std::vector<std::string> classifier_labels;
 
@@ -836,7 +843,7 @@ const char * llm_type_name(llm_type type);
     const int64_t n_embd_head_v  = hparams.n_embd_head_v();  GGML_UNUSED(n_embd_head_v); \
     const int64_t n_ff           = hparams.n_ff();           GGML_UNUSED(n_ff); \
     const int64_t n_embd_gqa     = n_embd_v_gqa;             GGML_UNUSED(n_embd_gqa); \
-    const int64_t n_vocab        = vocab.n_tokens();         GGML_UNUSED(n_vocab); \
+    const int64_t n_vocab        = n_vocab_hint > 0 ? n_vocab_hint : vocab.n_tokens(); GGML_UNUSED(n_vocab); \
     const int64_t n_token_types  = vocab.n_token_types();    GGML_UNUSED(n_token_types); \
     const int64_t n_rot          = hparams.n_rot();          GGML_UNUSED(n_rot); \
     const int64_t n_expert       = hparams.n_expert;         GGML_UNUSED(n_expert); \
diff --git a/src/llama.cpp b/src/llama.cpp
index 633db65..9fda723 100644
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -23,6 +23,7 @@
 #include <cstdio>
 #include <cstring>
 #include <ctime>
+#include <future>
 #include <stdexcept>
 #include <vector>
 
@@ -351,24 +352,75 @@ static std::pair<int, llama_model *> llama_model_load(struct gguf_context * meta
         if (model->arch == LLM_ARCH_CLIP) {
             throw std::runtime_error("CLIP cannot be used as main model, use it with --mmproj instead");
         }
-        try {
-            model->load_vocab(ml);
-        } catch(const std::exception & e) {
-            throw std::runtime_error("error loading model vocabulary: " + std::string(e.what()));
+        // Vocab construction (BPE merges map, token attributes, the
+        // token-to-piece cache) costs ~1.9s on a 250k-token vocab and shares
+        // no mutable loader state with tensor loading, which is I/O + DMA
+        // bound: the vocab thread only reads gguf metadata (get_key/get_arr
+        // are pure reads over the parsed gguf_context), while load_tensors
+        // touches tensor bookkeeping and file data. Overlap them so the
+        // vocab builds while the weights stream to the device. The only
+        // pre-return vocab consumer is print_info(), which joins first.
+        std::future<void> vocab_future;
+        auto load_vocab_inline = [&]() {
+            try {
+                model->load_vocab(ml);
+            } catch(const std::exception & e) {
+                throw std::runtime_error("error loading model vocabulary: " + std::string(e.what()));
+            }
+        };
+        auto join_vocab = [&]() {
+            if (!vocab_future.valid()) {
+                return;
+            }
+            try {
+                vocab_future.get();
+            } catch(const std::runtime_error &) {
+                throw;
+            } catch(const std::exception & e) {
+                throw std::runtime_error("error loading model vocabulary: " + std::string(e.what()));
+            }
+        };
+        // Tensor shapes only need the token COUNT from the vocab (see
+        // LLAMA_LOAD_LOCALS): pre-read it straight from the gguf metadata so
+        // load_tensors below never touches the concurrently-building vocab.
+        {
+            const int kid = gguf_find_key(ml.metadata, "tokenizer.ggml.tokens");
+            if (kid >= 0) {
+                model->n_vocab_hint = (int64_t) gguf_get_arr_n(ml.metadata, kid);
+            }
+        }
+
+        if (params.vocab_only || model->n_vocab_hint <= 0) {
+            // nothing to overlap with (or no token list to size shapes from):
+            // serial load, exactly the old path
+            load_vocab_inline();
+        } else {
+            try {
+                vocab_future = std::async(std::launch::async, [&]() { load_vocab_inline(); });
+            } catch(...) {
+                // thread creation failed - fall back to the serial path
+                load_vocab_inline();
+            }
         }
 
         model->load_stats(ml);
-        model->print_info();
 
         if (params.vocab_only) {
+            model->print_info();
             LLAMA_LOG_INFO("%s: vocab only - skipping tensors\n", __func__);
             return {0, model_ptr.release()};
         }
 
         if (!model->load_tensors(ml)) {
+            // surface a tensor failure over a concurrent vocab failure, but
+            // never leave the worker running past this frame's lifetime
+            try { join_vocab(); } catch(...) {}
             return {-2, nullptr};
         }
 
+        join_vocab();
+        model->print_info();
+
         return {0, model_ptr.release()};
     } catch (const std::exception & err) {
         LLAMA_LOG_ERROR("%s: error loading model: %s\n", __func__, err.what());
-- 
