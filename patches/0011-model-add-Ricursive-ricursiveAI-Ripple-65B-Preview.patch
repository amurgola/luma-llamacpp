new file mode 100644
index 000000000..499f4575f
--- /dev/null
+++ b/conversion/ricursive.py
@@ -0,0 +1,53 @@
+from __future__ import annotations
+
+from typing import Iterable, TYPE_CHECKING
+
+from .base import ModelBase, TextModel, gguf
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+
+@ModelBase.register("RicursiveForCausalLM")
+@ModelBase.example("ricursiveAI/Ripple-65B-Preview")
+class RicursiveModel(TextModel):
+    model_arch = gguf.MODEL_ARCH.RICURSIVE
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._value_res_lambda: dict[int, float] = {}
+
+    def set_vocab(self):
+        self._set_vocab_gpt2()
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        hparams = self.hparams
+
+        # local layers: sliding window + RoPE; global layers (every 5th by default): full attention, no RoPE
+        layer_types = hparams.get("layer_types")
+        if layer_types is None:
+            layer_types = ["full_attention" if i % 5 == 4 else "sliding_attention" for i in range(self.block_count)]
+        assert len(layer_types) == self.block_count
+        if "sliding_attention" in layer_types:
+            self.gguf_writer.add_sliding_window(hparams["sliding_window"])
+            self.gguf_writer.add_sliding_window_pattern([t == "sliding_attention" for t in layer_types])
+
+        # non-folded checkpoints carry the embedding scale in the config; folded ones bake it into the weights
+        if (embed_scale := hparams.get("embed_scale")) is not None:
+            self.gguf_writer.add_embedding_scale(float(embed_scale))
+
+        # FFN: silu(min(gate, c)) * clamp(up, -c, c)
+        if (clamp := hparams.get("ffn_clamp_threshold")):
+            self.gguf_writer.add_swiglu_clamp(float(clamp))
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        # value residual: one scalar per layer, stored as a hparam array instead of a tensor
+        if name.endswith(".self_attn.value_res_lambda"):
+            assert bid is not None
+            self._value_res_lambda[bid] = data_torch.to("cpu").float().item()
+            if len(self._value_res_lambda) == self.block_count:
+                self.gguf_writer.add_value_residual_lambda([self._value_res_lambda[k] for k in sorted(self._value_res_lambda)])
+            return []
+
+        return [(self.map_tensor_name(name), data_torch)]
