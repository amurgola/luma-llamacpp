From ecf159a61810a707dbb7df2146152d4a10071359 Mon Sep 17 00:00:00 2001
From: Andrew Murgola <andy@murgo.la>
Date: Thu, 3 Sep 2026 16:17:26 -0400
Subject: [PATCH 2/2] model-loader: async staged uploads + parallel prefault
 for mmap sources

The pinned-staging async upload pipeline previously refused mmap
sources, so mmap-loaded weights destined for a device buffer fell back
to one synchronous pageable ggml_backend_tensor_set per tensor. Allow
upload_backend for mmap: fill the staging buffers with memcpy from the
mapping (64MB chunks - there is no per-read latency to hide, so larger
chunks amortize event synchronization) and upload asynchronously.

Staging alone is not enough: the bottleneck is per-page soft-fault
wire-in of the mapping, which is single-threaded in the copy loop. Add
prefault helper threads that walk the upcoming tensor ranges (skipping
lazy tensors), calling llama_mmap::populate() per 256MB unit and then
touching pages as the wiring fallback, so the staging memcpy reads
already-wired memory.

Measured on a 21.5 GiB Q6_K model, warm page cache, RTX 5090 (PCIe 5.0
x16), Windows 11, load-to-healthy of llama-server:

  --load-mode mmap  before: 12.8-13.1 s   after: 8.25-8.32 s
  weight-upload phase alone: ~6.7 s -> ~2.2 s (~3.2 -> ~9.8 GB/s)
  --no-mmap (unchanged): 8.5-9.4 s

mmap becomes the fastest load mode while keeping its zero-copy RAM
profile (no transient heap copy of the weights).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TRNybKMfE2D3yiS9yXLBfe
---
 src/llama-model-loader.cpp | 95 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 91 insertions(+), 4 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 49f3c4f..6d5a6ab 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -12,7 +12,9 @@
 #include <cstdint>
 #include <cstring>
 #include <future>
+#include <atomic>
 #include <regex>
+#include <thread>
 
 static const size_t kiB = 1024;
 static const size_t MiB = 1024*kiB;
@@ -1509,18 +1511,23 @@ bool llama_model_loader::load_all_data(
     }
 
     // Buffer size: balance between memory usage and I/O efficiency
-    // 64MB works well for NVMe drives
-    const size_t buffer_size = alignment != 1 ? 64 * 1024 * 1024 + 2 * alignment : 1 * 1024 * 1024;
+    // 64MB works well for NVMe drives. The mmap staging path (memcpy from the
+    // mapping) has no per-read latency to hide, so bigger chunks amortize the
+    // per-chunk event synchronization instead.
+    const size_t buffer_size = (alignment != 1 || use_mmap) ? 64 * 1024 * 1024 + 2 * alignment : 1 * 1024 * 1024;
 
     std::vector<ggml_backend_buffer_t> host_buffers;
     std::vector<ggml_backend_event_t> events;
     std::vector<void *> host_ptrs;
     size_t buffer_idx = 0; // buffer to use for async loads
     ggml_backend_t upload_backend = [&](const char * func) -> ggml_backend_t {
-        if (use_mmap || check_tensors) {
+        if (check_tensors) {
             return nullptr;
         }
-        // When not using mmaped io use async uploads from pinned memory to GPU memory.
+        // Use async uploads from pinned memory to GPU memory. For non-mmap io
+        // the staging buffers are filled from file reads; for mmap io they are
+        // filled with memcpy from the mapping, which reads the page cache at
+        // memory speed instead of the synchronous pageable-copy fallback.
         // First determine if the backend supports the necessary features for async uploads.
         auto * buf = bufs.count(0) ? bufs.at(0) : nullptr;
         if (!buf) {
@@ -1615,6 +1622,63 @@ bool llama_model_loader::load_all_data(
         });
     }
 
+    // Pre-fault the mapped ranges on helper threads. The OS wires mapped
+    // pages into the working set one soft fault at a time — measured ~2-3
+    // GB/s on one thread on Windows even with the file fully in the page
+    // cache (PrefetchVirtualMemory is a best-effort hint and does not
+    // guarantee working-set insertion) — and that, not the copy or the DMA,
+    // is what bounds mmap load speed. Faulting scales across threads, so a
+    // few touchers running ahead of the staging loop below turn its memcpy
+    // into wired-memory reads. Lazy tensors are skipped (faulting them in
+    // is exactly what lazy avoids).
+    std::vector<std::thread> prefaulters;
+    struct prefault_joiner {
+        std::vector<std::thread> & ts;
+        ~prefault_joiner() { for (auto & t : ts) { if (t.joinable()) { t.join(); } } }
+    } prefault_join { prefaulters };
+    std::atomic<size_t> prefault_next{0};
+    struct prefault_range {
+        const llama_mmap * map;
+        size_t offs;
+        size_t len;
+    };
+    std::vector<prefault_range> prefault_ranges;
+    if (use_mmap && upload_backend) {
+        // 256MB work units: big enough for an efficient ranged populate()
+        // call, small enough that the threads stay load-balanced.
+        constexpr size_t chunk = 256u * 1024 * 1024;
+        for (ggml_tensor * cur : tensors) {
+            const auto * weight = get_weight(ggml_get_name(cur));
+            if (weight == nullptr || lazy.has(cur)) {
+                continue;
+            }
+            if (cur->buffer == nullptr || ggml_backend_buffer_is_host(cur->buffer)) {
+                continue;
+            }
+            const auto & mapping = mappings.at(weight->idx);
+            const size_t n_size = ggml_nbytes(cur);
+            for (size_t off = 0; off < n_size; off += chunk) {
+                prefault_ranges.push_back({ mapping.get(), weight->offs + off, std::min(chunk, n_size - off) });
+            }
+        }
+        const int n_prefault_threads = 6;
+        for (int t = 0; t < n_prefault_threads; ++t) {
+            prefaulters.emplace_back([&prefault_next, &prefault_ranges]() {
+                for (size_t i = prefault_next.fetch_add(1); i < prefault_ranges.size(); i = prefault_next.fetch_add(1)) {
+                    const auto & r = prefault_ranges[i];
+                    // Ranged kernel-side working-set insertion first, then a
+                    // strided touch as the wiring fallback (cheap when the
+                    // populate already wired the pages).
+                    r.map->populate(r.offs, r.offs + r.len);
+                    const volatile char * p = (const volatile char *) r.map->addr() + r.offs;
+                    for (size_t off = 0; off < r.len; off += 4096) {
+                        (void) p[off];
+                    }
+                }
+            });
+        }
+    }
+
     for (struct ggml_tensor * cur : tensors) {
         const auto * weight = get_weight(ggml_get_name(cur));
         if (weight == nullptr) {
@@ -1659,6 +1723,29 @@ bool llama_model_loader::load_all_data(
                 auto & mmap_used = mmaps_used[weight->idx];
                 mmap_used.first  = std::min(mmap_used.first,  weight->offs);
                 mmap_used.second = std::max(mmap_used.second, weight->offs + n_size);
+            } else if (upload_backend && cur->buffer && !ggml_backend_buffer_is_host(cur->buffer)) {
+                // Mapped source, device destination: stage through the pinned
+                // buffers and upload asynchronously. memcpy from the
+                // (prefetched) mapping runs at RAM speed and overlaps with the
+                // DMA of the previous chunk, where the plain tensor_set below
+                // is a synchronous pageable copy per tensor.
+                size_t data_done = 0;
+                while (data_done < n_size) {
+                    const size_t chunk = std::min<size_t>(buffer_size, n_size - data_done);
+
+                    // Wait for the previous upload to complete before reusing the buffer
+                    ggml_backend_event_synchronize(events[buffer_idx]);
+
+                    memcpy(host_ptrs[buffer_idx], data + data_done, chunk);
+
+                    ggml_backend_tensor_set_async(upload_backend, cur,
+                                                  host_ptrs[buffer_idx], data_done, chunk);
+                    ggml_backend_event_record(events[buffer_idx], upload_backend);
+
+                    data_done += chunk;
+                    ++buffer_idx;
+                    buffer_idx %= n_buffers;
+                }
             } else {
                 ggml_backend_tensor_set(cur, data, 0, n_size);
             }
-- 
