     // the host expert tensors of each layer, in any order: an expert is the same slice of each of them
@@ -116,10 +224,11 @@ size_t llama_moe_pin_host_experts(const llama_model & model, size_t budget, cons
         }
     }
 
-    // the ranges to lock, per layer
+    // the ranges to lock, per layer, with the expert's position in the use order
     struct range {
         void * addr;
         size_t len;
