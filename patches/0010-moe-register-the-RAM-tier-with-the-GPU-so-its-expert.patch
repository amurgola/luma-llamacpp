+bool llama_moe_host_registry::contains(const void * p, size_t n) const {
+    const uintptr_t begin = (uintptr_t) p;
+    const uintptr_t end   = begin + n;
+    auto it = std::upper_bound(ranges.begin(), ranges.end(), begin, [](uintptr_t b, const range & r) { return b < r.begin; });
+    if (it == ranges.begin()) {
+        return false;
+    }
+    --it;
+    return begin >= it->begin && end <= it->end;
+}
+
+size_t llama_moe_host_registry::bytes() const {
+    size_t n = 0;
+    for (const range & r : ranges) {
+        n += r.end - r.begin;
+    }
+    return n;
+}
+
+void llama_moe_host_registry::clear() {
+    if (unregister_fn != nullptr) {
+        for (const range & r : ranges) {
+            unregister_fn((void *) r.begin);
+        }
+    }
+    ranges.clear();
+}
+
+// register the locked ranges with the first backend that pins host memory, in rank order up to the budget:
+// page-rounded, merged where they touch
+struct llama_moe_locked_range {
+    size_t    rank; // position in the use order, lowest first
+    uintptr_t begin;
+    uintptr_t end;
+};
+
+static void llama_moe_register_host_ranges(llama_moe_host_registry & registry, const std::vector<ggml_backend_t> & backends,
+        std::vector<llama_moe_locked_range> & ranked, size_t budget) {
+    typedef bool (*register_fn_t)(void *, size_t);
+    typedef void (*unregister_fn_t)(void *);
+    register_fn_t   register_fn   = nullptr;
+    unregister_fn_t unregister_fn = nullptr;
+    const char * backend_name = "";
+    for (ggml_backend_t backend : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+        ggml_backend_reg_t reg = dev != nullptr ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        if (reg == nullptr) {
+            continue;
+        }
+        register_fn   = (register_fn_t)   ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_range");
+        unregister_fn = (unregister_fn_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_range");
+        if (register_fn != nullptr && unregister_fn != nullptr) {
+            backend_name = ggml_backend_name(backend);
+            break;
+        }
+    }
+    if (register_fn == nullptr || unregister_fn == nullptr) {
+        LLAMA_LOG_INFO("%s: no backend pins host memory, the RAM tier uploads through the staging copy\n", __func__);
+        return;
+    }
+
+    const int64_t t_start = ggml_time_us();
+    std::sort(ranked.begin(), ranked.end(), [](const llama_moe_locked_range & a, const llama_moe_locked_range & b) { return a.rank < b.rank; });
+    std::vector<std::pair<uintptr_t, uintptr_t>> locked;
+    size_t chosen = 0;
+    for (const auto & r : ranked) {
+        if (chosen + (r.end - r.begin) > budget) {
+            break;
+        }
+        chosen += r.end - r.begin;
+        locked.emplace_back(r.begin, r.end);
+    }
+    const uintptr_t page = 4096;
+    for (auto & r : locked) {
+        r.first  = r.first & ~(page - 1);
+        r.second = (r.second + page - 1) & ~(page - 1);
+    }
+    std::sort(locked.begin(), locked.end());
+    std::vector<std::pair<uintptr_t, uintptr_t>> merged;
+    for (const auto & r : locked) {
+        if (!merged.empty() && r.first <= merged.back().second) {
+            merged.back().second = std::max(merged.back().second, r.second);
+        } else {
+            merged.push_back(r);
+        }
+    }
+
+    registry.clear();
+    registry.unregister_fn = unregister_fn;
+    size_t n_failed = 0;
+    size_t failed_bytes = 0;
+    for (const auto & r : merged) {
+        if (register_fn((void *) r.first, r.second - r.first)) {
+            registry.ranges.push_back({ r.first, r.second });
+        } else {
+            n_failed++;
+            failed_bytes += r.second - r.first;
+        }
+    }
+    LLAMA_LOG_INFO("%s: registered %.2f GiB of the RAM tier with %s (%zu of %zu ranges, budget %.2f GiB) in %.1f s, uploads from it are direct\n", __func__,
+        registry.bytes()/1024.0/1024.0/1024.0, backend_name, locked.size(), ranked.size(), budget/1024.0/1024.0/1024.0, (ggml_time_us() - t_start)/1e6);
+    if (n_failed > 0) {
+        LLAMA_LOG_WARN("%s: %zu ranges (%.2f GiB) could not be registered, they upload through the staging copy\n", __func__,
+            n_failed, failed_bytes/1024.0/1024.0/1024.0);
+    }
+}
