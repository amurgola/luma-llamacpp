index e322c3578..2b02bd2f4 100644
--- a/src/llama-mmap.h
+++ b/src/llama-mmap.h
@@ -95,4 +95,10 @@ using llama_memory_ranges = std::vector<llama_memory_range>;
 // Prefetch the host pages covering these memory ranges.
 void llama_prefetch(llama_memory_ranges mr);
 
+// Lock [addr, addr + len) in RAM (VirtualLock / mlock); on Windows the working set limit is raised when it is short.
+bool llama_mlock_range(void * addr, size_t len);
+
+// Raise the working set limit by bytes ahead of many llama_mlock_range calls (Windows only, no-op elsewhere).
+void llama_mlock_reserve(size_t bytes);
+
