 void llama_moe_profile::init(int32_t n_layer, int32_t n_expert) {
     this->n_layer  = n_layer;
@@ -77,6 +81,121 @@ bool llama_moe_profile::load(const std::string & path, int32_t n_layer, int32_t
     return true;
 }
 
+size_t llama_moe_pin_host_experts(const llama_model & model, size_t budget, const llama_moe_profile * profile,
+        const std::function<bool(int32_t, int32_t)> & skip) {
+    const int32_t n_layer = (int32_t) model.layers.size();
+
+    // the host expert tensors of each layer, in any order: an expert is the same slice of each of them
+    std::vector<std::vector<const ggml_tensor *>> experts(n_layer);
+    int32_t n_expert = 0;
+    for (int32_t il = 0; il < n_layer; ++il) {
+        const auto & layer = model.layers[il];
+        for (const ggml_tensor * t : { layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps }) {
+            if (t != nullptr && t->buffer != nullptr && t->data != nullptr &&
+                    ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+                    ggml_backend_buffer_is_host(t->buffer)) {
+                experts[il].push_back(t);
+                n_expert = std::max<int32_t>(n_expert, (int32_t) t->ne[2]);
+            }
+        }
+    }
+    if (n_expert == 0) {
+        LLAMA_LOG_WARN("%s: no expert tensor is in host memory, nothing to lock\n", __func__);
+        return 0;
+    }
+
+    std::vector<std::pair<int32_t, int32_t>> order;
+    if (profile != nullptr && !profile->empty() && profile->n_layer == n_layer && profile->n_expert == n_expert) {
+        order = profile->ranked();
+    } else {
+        order.reserve((size_t) n_layer*n_expert);
+        for (int32_t il = 0; il < n_layer; ++il) {
+            for (int32_t e = 0; e < n_expert; ++e) {
+                order.emplace_back(il, e);
+            }
+        }
+    }
+
+    // the ranges to lock, per layer
+    struct range {
+        void * addr;
+        size_t len;
+    };
+    std::vector<std::vector<range>> ranges(n_layer);
+    size_t selected = 0;
+    size_t n_selected = 0;
+    size_t n_total = 0;
+    for (int32_t il = 0; il < n_layer; ++il) {
+        n_total += experts[il].empty() ? 0 : experts[il][0]->ne[2];
+    }
+    for (const auto & [il, e] : order) {
+        if (experts[il].empty() || e >= (int32_t) experts[il][0]->ne[2] || skip(il, e)) {
+            continue;
+        }
+        size_t bytes = 0;
+        for (const ggml_tensor * t : experts[il]) {
+            bytes += t->nb[2];
+        }
+        if (selected + bytes > budget) {
+            break;
+        }
+        for (const ggml_tensor * t : experts[il]) {
+            ranges[il].push_back({ (uint8_t *) t->data + (size_t) e*t->nb[2], t->nb[2] });
+        }
+        selected += bytes;
+        n_selected++;
+    }
+    if (n_selected == 0) {
+        LLAMA_LOG_WARN("%s: the budget of %.2f MiB holds no expert, nothing to lock\n", __func__, budget/1024.0/1024.0);
+        return 0;
+    }
+
+    const int64_t t_start = ggml_time_us();
+    llama_mlock_reserve(selected + 64u*1024*1024);
+
+    // the pages are read ahead with all the reads of a layer in flight, then locked, a few layers at a time
+    std::atomic<int32_t> next{0};
+    std::atomic<size_t> locked{0};
+    std::atomic<size_t> n_failed{0};
+    auto work = [&]() {
+        for (int32_t il = next.fetch_add(1); il < n_layer; il = next.fetch_add(1)) {
+            if (ranges[il].empty()) {
+                continue;
+            }
+            llama_memory_ranges mr;
+            mr.reserve(ranges[il].size());
+            for (const range & r : ranges[il]) {
+                mr.push_back({ r.addr, r.len });
+            }
+            llama_prefetch(std::move(mr));
+            for (const range & r : ranges[il]) {
+                if (llama_mlock_range(r.addr, r.len)) {
+                    locked += r.len;
+                } else {
+                    n_failed++;
+                }
+            }
+        }
+    };
+    const int n_threads = std::max(1, std::min(4, (int) std::thread::hardware_concurrency()/2));
+    std::vector<std::thread> threads;
+    for (int t = 1; t < n_threads; ++t) {
+        threads.emplace_back(work);
+    }
+    work();
+    for (auto & t : threads) {
+        t.join();
+    }
+
+    LLAMA_LOG_INFO("%s: locked %.2f GiB of host experts in RAM (%zu of %zu experts, %s order) in %.1f s\n", __func__,
+        locked/1024.0/1024.0/1024.0, n_selected, n_total, profile != nullptr && !profile->empty() ? "profile" : "layer",
+        (ggml_time_us() - t_start)/1e6);
+    if (n_failed > 0) {
+        LLAMA_LOG_WARN("%s: %zu expert ranges could not be locked, they stay pageable\n", __func__, (size_t) n_failed);
+    }
+    return locked;
+}
+
 bool llama_moe_profile::save(const std::string & path) {
     if (empty()) {
         return false;
