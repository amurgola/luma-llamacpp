diff --git a/src/llama-mmap.cpp b/src/llama-mmap.cpp
index 85453c1e8..a65b4f05f 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -874,6 +874,48 @@ const bool llama_mlock::SUPPORTED = true;
 const bool llama_mlock::SUPPORTED = false;
 #endif
 
+#if defined(_WIN32)
+void llama_mlock_reserve(size_t bytes) {
+    SIZE_T min_ws_size, max_ws_size;
+    if (!GetProcessWorkingSetSize(GetCurrentProcess(), &min_ws_size, &max_ws_size)) {
+        LLAMA_LOG_WARN("warning: GetProcessWorkingSetSize failed: %s\n", llama_format_win_err(GetLastError()).c_str());
+        return;
+    }
+    if (!SetProcessWorkingSetSize(GetCurrentProcess(), min_ws_size + bytes, max_ws_size + bytes)) {
+        LLAMA_LOG_WARN("warning: SetProcessWorkingSetSize failed: %s\n", llama_format_win_err(GetLastError()).c_str());
+    }
+}
+
+bool llama_mlock_range(void * addr, size_t len) {
+    if (VirtualLock(addr, len)) {
+        return true;
+    }
+    llama_mlock_reserve(len + 1048576);
+    return VirtualLock(addr, len) != 0;
+}
+#elif defined(_POSIX_MEMLOCK_RANGE)
+void llama_mlock_reserve(size_t bytes) {
+    GGML_UNUSED(bytes);
+}
+
+bool llama_mlock_range(void * addr, size_t len) {
+    const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    const uintptr_t first = (uintptr_t) addr / page * page;
+    const uintptr_t last  = ((uintptr_t) addr + len + page - 1) / page * page;
+    return mlock((void *) first, last - first) == 0;
+}
+#else
+void llama_mlock_reserve(size_t bytes) {
+    GGML_UNUSED(bytes);
+}
+
+bool llama_mlock_range(void * addr, size_t len) {
+    GGML_UNUSED(addr);
+    GGML_UNUSED(len);
+    return false;
+}
+#endif
+
 void llama_prefetch(llama_memory_ranges mr) {
 #if defined(__linux__) || defined(__APPLE__) || (defined(_WIN32) && _WIN32_WINNT >= 0x602)
     if (mr.empty()) {
